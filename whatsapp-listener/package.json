{
    "name": "whatsapp-listener",
    "version": "1.0.0",
    "description": "WhatsApp group listener using whatsapp-web.js - forwards messages to GIS processor",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "clean": "rm -rf dist .wwebjs_auth .wwebjs_cache",
        "postinstall": "node patches/patch-wwebjs.js"
    },
    "keywords": ["whatsapp", "gis"],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@gis-bot/shared": "1.0.0",
        "qrcode-terminal": "^0.12.0",
        "whatsapp-web.js": "^1.34.4"
    },
    "devDependencies": {
        "@types/node": "^20.9.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    }
}
